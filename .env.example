# --- MongoDB Atlas ---
# Format: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/rad-der-schande?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth.js v5 ---
# Generieren mit:  npx auth secret
AUTH_SECRET=

# --- Google OAuth ---
# https://console.cloud.google.com  →  APIs & Services  →  Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Auth.js Trust-Host (lokal optional, in Prod auf Vercel automatisch) ---
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Web-Push (Phase 3) ---
# Generieren mit:  npm run gen-vapid
# Public Key ist im Browser sichtbar (via /api/push/key) — kein Geheimnis.
# Private Key NIE preisgeben.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dein-name@example.com
